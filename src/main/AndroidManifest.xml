<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- POST_NOTIFICATIONS (Android 13+) is requested by the HOST app at
         runtime; declaring it here merges it into their manifest. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Zero-code path: host apps that don't have their own
             FirebaseMessagingService get ours via manifest merge.
             Hosts with their own service: omit this by tools:node="remove"
             and forward the two callbacks instead (see README). -->
        <!-- Click trampoline: SDK-rendered notifications route taps through
             this receiver so opens are recorded automatically. -->
        <receiver
            android:name="com.notibase.sdk.NotibaseClickReceiver"
            android:exported="false" />

        <service
            android:name="com.notibase.sdk.NotibaseMessagingService"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
